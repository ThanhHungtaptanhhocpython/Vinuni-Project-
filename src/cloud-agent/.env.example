# Cloud Agent
APP_NAME=AI20K Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI20K VLM Agent
GEMINI_API_KEY=
MODEL_NAME=gpt-4o
MODEL_FALLBACK=gpt-4o-mini
LLM_TIMEOUT_S=45
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Agent
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_TAKE_ACTION=2
AGENT_MAX_RUN_DURATION_S=900
AGENT_CONTEXT_TOKEN_BUDGET=100000
AGENT_VERBOSE=standard
AGENT_VERBOSE_MAX_VALUE_LENGTH=2000

# Edge MCP
MCP_ENDPOINT_URL=http://localhost:8931/mcp
MCP_PROTOCOL_VERSION=2025-03-26
MCP_CLIENT_NAME=p172-cloudagent
MCP_CLIENT_VERSION=0.1.0
MCP_LIBERO_QUIRKS=false
MCP_AUTH_TOKEN=

# Storage — PostgreSQL (docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/p172
CHROMA_PERSIST_DIR=./data/chroma
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=long_term_memories
EMBEDDING_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_TOP_K=5

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console → Authorized redirect URIs EXACTLY.
# Use the UI origin so Next.js can rewrite /api/* → cloud-agent and keep
# oauth_state + refresh_token cookies first-party on :3000.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
UI_BASE=http://localhost:3000
JWT_SECRET=
JWT_SECRET_FILE=data/.jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=1209600
ALLOWED_EMAIL_DOMAINS=
AUTH_REQUIRED=false
AUTH_COOKIE_SECURE=true

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai20k-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=
LANGFUSE_ENVIRONMENT=development


EDGE_JWT_SECRET=