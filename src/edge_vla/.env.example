# ---------------------------------------------------------------------------
# Edge VLA configuration.
#
# Only machine-dependent values live here. The hard safety and operational
# bounds (max retries, poll limits, safety thresholds) are fixed in config.py
# on purpose and are deliberately NOT overridable from the environment.
# ---------------------------------------------------------------------------

# Which robot to drive at startup: "sim" or "real".
#   sim  -> LIBERO/MuJoCo Franka, 7-D delta-EEF actions, radians
#   real -> physical SO-101 via lerobot, 6-D joint positions, degrees
# Can also be switched at runtime with the set_mode MCP tool or POST /mode.
ROBOT_MODE=sim

# MCP + /mjpeg + /servo-stream + /mode all listen on this port.
VLA_MCP_PORT=8931

# Replaying an action chunk instead of re-running inference every step. Applies
# to both modes.
VLA_N_ACTION_STEPS=10

# --- real mode only --------------------------------------------------------

# Serial port of the SO-101 follower arm.
VLA_REAL_PORT=/dev/ttyACM0

# lerobot calibration id. The arm MUST already be calibrated — lerobot's
# calibration routine is interactive and cannot run from this server. Calibrate
# once with the lerobot CLI, then put that id here.
VLA_REAL_ROBOT_ID=so101_follower

# A checkpoint fine-tuned on SO-101 data. Required in real mode. The LIBERO
# checkpoint used in sim mode will NOT drive this arm — different action space.
VLA_REAL_POLICY_REPO=

# Control loop rate in Hz for the real arm.
VLA_REAL_CONTROL_FREQ=30

# Cameras, as JSON mapping a name to OpenCVCameraConfig kwargs. The names become
# the keys returned by capture() and the panels in /mjpeg.
VLA_REAL_CAMERAS={"wrist": {"index_or_path": 0, "width": 640, "height": 480, "fps": 30}}

# Per-command joint delta cap, in degrees. This is lerobot's own first line of
# defence against a runaway policy output — do not raise it casually and never
# leave it empty.
VLA_REAL_MAX_REL_TARGET=5.0

# MuJoCo rendering backend for sim mode.
# Linux headless: egl (or osmesa). macOS: leave unset / cgl — egl is invalid.
# MUJOCO_GL=egl

CLOUD_AGENT_BASE_URL=http://localhost:8000
# URL cloud-agent gọi ngược vào Edge để relay /mjpeg và /servo-stream.
# Dùng tunnel/LAN URL nếu cloud-agent không chạy cùng máy.
EDGE_PUBLIC_URL=http://127.0.0.1:8931
# PHẢI khớp EDGE_JWT_SECRET phía cloud-agent/.env (HS256, đối xứng).
EDGE_JWT_SECRET=
# Để trống = tự sinh UUID lúc khởi động lần đầu, lưu vào .edge_robot_id cạnh
# file này để giữ nguyên qua các lần restart.
EDGE_ROBOT_ID=
