# Copy sang .env.local (không commit .env.local) rồi điền giá trị thật.

# ---- Cloud API (Next.js rewrite /api/* -> Cloud) ----
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# NEXT_PUBLIC_USE_MOCK=0 tắt mock — auth Google SSO + chat/robots hit Cloud thật.
# Để 1 khi Cloud backend chưa sẵn sàng.
NEXT_PUBLIC_USE_MOCK=0

# ---- Camera / WebRTC (edge_vla) ----
# Bật riêng camera thật trong khi phần còn lại của app vẫn mock (lib/mock/index.ts).
# Không cần set nếu đã NEXT_PUBLIC_USE_MOCK=0 ở trên.
NEXT_PUBLIC_CAMERA_LIVE=1

# Base URL of the edge_vla MCP HTTP server (VLA_MCP_PORT, default 8931).
# Tunnel example: https://xxxx.trycloudflare.com
# Do NOT use :9000 — that is not this process (often MinIO/S3).
# No NEXT_PUBLIC_ prefix: only /api/webrtc/* on the Next server calls edge_vla.
EDGE_VLA_URL=http://127.0.0.1:8931

# EDGE_VLA_MCP_TOKEN trong webrtc_test.html — bearer token của edge_vla. Để
# trống nếu edge_vla đang chạy không bật auth. KHÔNG thêm tiền tố NEXT_PUBLIC_,
# token không được lọt vào bundle JS của trình duyệt.
EDGE_VLA_TOKEN=

# ICE servers gửi cho trình duyệt (app/api/webrtc/config). Để trống cả hai thì
# trình duyệt chỉ gom được host candidate — chỉ chạy khi UI và edge_vla cùng
# LAN. Qua tunnel (trycloudflare/ngrok) bắt buộc phải có ít nhất STUN.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# Nhiều URL cách nhau bằng dấu phẩy, vd: turn:turn.example.com:3478,turns:turn.example.com:5349
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Camera/servo stream đi qua cloud-agent. Cấu hình URL edge ở
# src/edge_vla/.env bằng EDGE_PUBLIC_URL, không cấu hình trực tiếp trong UI.

# Mock speed multiplier (chat/robots/sessions SSE khi NEXT_PUBLIC_USE_MOCK=1)
NEXT_PUBLIC_MOCK_SPEED=1
