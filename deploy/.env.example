# Copy to /opt/p172/.env on the VM and fill in. Never commit real secrets.

# Public URL browsers use (no trailing slash). Must match Google OAuth redirect.
# Domain example: https://p172.example.com
# IP-only (HTTP): http://34.x.x.x  and set AUTH_COOKIE_SECURE=false
PUBLIC_BASE_URL=https://p172.example.com
PUBLIC_HOST=p172.example.com

AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT for browser sessions (min 32 chars)
JWT_SECRET=

# Shared HS256 secret for Edge self-registration (min 32 chars).
# Must be set on BOTH cloud-agent and edge-vla (compose passes it through).
EDGE_JWT_SECRET=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
MODEL_NAME=gemini-2.0-flash
MODEL_FALLBACK=gemini-2.0-flash-lite

# Agent run ceiling (seconds). Robot episodes on slow osmesa sim need headroom
# beyond capture + LLM + one k=500 take_action (~400s sim budget alone).
AGENT_MAX_RUN_DURATION_S=900

# Used only to seed the initial robot list (max 1 robot for now).
# Must match Edge service `ROBOT_MODE` in `deploy/docker-compose.yml`.
EDGE_ROBOT_MODE=sim

# Optional long-term memory
LONG_TERM_MEMORY_ENABLED=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=long_term_memories
LONG_TERM_MEMORY_TOP_K=5

# Postgres (compose service defaults — change password in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p172
DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/p172

# Edge auth token (optional). Same value on frontend + edge.
EDGE_VLA_TOKEN=

# Stable robot id across Edge restarts (optional). Empty = auto-generated once.
EDGE_ROBOT_ID=

# WebRTC ICE (optional TURN if clients are behind strict NAT)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Edge ↔ Cloud wiring (single-VM defaults — leave as-is unless you split hosts)
# Edge (host net) → Cloud: compose publishes cloud-agent on 127.0.0.1:8000
# CLOUD_AGENT_BASE_URL=http://127.0.0.1:8000
# Cloud (bridge) → Edge: host-gateway reaches Edge's host-network :8931
# EDGE_PUBLIC_URL=http://host.docker.internal:8931
# MCP_ENDPOINT_URL=http://host.docker.internal:8931/mcp
# EDGE_VLA_INTERNAL_URL=http://host.docker.internal:8931
